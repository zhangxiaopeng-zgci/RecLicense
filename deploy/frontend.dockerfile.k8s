FROM node:16 AS builder

# install dependencies
RUN mkdir /frontend
COPY ./frontend/package-lock.json ./frontend/package.json /frontend/
WORKDIR /frontend
RUN npm ci --force

# Build frontend
ARG NODE_ENV
ARG REACT_APP_BASE_URL
COPY ./frontend/ /frontend
RUN npm run build

FROM caddy

EXPOSE 80
EXPOSE 443
# Copy caddy configration for K8s (uses reclicense-backend service name)
COPY deploy/frontend.caddyfile.k8s /etc/caddy/Caddyfile
# Copy artifact
COPY --from=builder /frontend/dist /wwwroot
