# RecLicense Docker Compose Environment Variables

# GitHub Token (required for GitHub API)
# Get from: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here

# Gitee Token (optional, for private repos)
# Get from: https://gitee.com/profile/personal_access_tokens
GITEE_TOKEN=

# GitLab Token (optional, for private repos)
# Get from: https://gitlab.com/-/profile/personal_access_tokens
GITLAB_TOKEN=

# Private Gitee Token (for https://z.gitee.cn/)
GITEE_PRIVATE_TOKEN=your_gitee_private_token_here
